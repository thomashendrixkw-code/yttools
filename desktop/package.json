{
  "name": "yttools-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "macOS desktop shell for YT Tools",
  "main": "main.js",
  "scripts": {
    "prepare-resources": "node scripts/prepare-resources.mjs",
    "start": "npm run prepare-resources && electron .",
    "dist": "npm run prepare-resources && electron-builder",
    "dist:dir": "npm run prepare-resources && electron-builder --dir",
    "dist:mac": "npm run prepare-resources && electron-builder --mac",
    "dist:win": "npm run prepare-resources && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ffmpeg-static": "^5.3.0"
  }
}
