# Absolute path to the yt-dlp binary. Leave unset to resolve it from PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# Absolute path to the ffmpeg binary. Leave unset to resolve it from PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Max number of downloads a single IP may start per rolling window.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Hard ceiling on how long a single yt-dlp invocation may run (milliseconds).
DOWNLOAD_TIMEOUT_MS=900000

# Max number of playlist entries a single batch download may contain.
MAX_PLAYLIST_ITEMS=25

# Optional: path to a cookies.txt file, used for videos that require a signed-in
# session you legitimately hold. Never use this to bypass age or region gates.
# YT_DLP_COOKIES=/data/cookies.txt
